          "docs": "Deletes a custom field definition by id in the specified setting if settingId is provided, or in the global scope otherwise."
        },
        {
          "info": {
            "name": "Create a custom fields setting",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v2/settings/customFields/settings",
            "body": {
              "type": "json",
              "data": "{}"
            }
