          "http": {
            "method": "PUT",
            "url": "/api/v2/settings/customFields/dropdown/:customFieldId",
            "params": [
              {
                "name": "customFieldId",
                "value": "",
                "type": "path"
              },
              {
                "name": "settingId",
                "value": "",
                "type": "query",
                "description": "Setting id the custom field belongs to. Omit for global."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a dropdown custom field definition in the specified setting if settingId is provided, or in the global scope otherwise."
        },
        {
          "info": {
            "name": "Create a toggle custom field",
