          "info": {
            "name": "Update a custom fields setting",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/api/v2/settings/customFields/settings/:settingId",
            "params": [
              {
                "name": "settingId",
                "value": "",
