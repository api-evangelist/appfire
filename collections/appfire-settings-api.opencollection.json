          },
          "http": {
            "method": "POST",
            "url": "/api/v2/settings/customFields/toggle",
            "params": [
              {
                "name": "settingId",
                "value": "",
                "type": "query",
                "description": "Setting id to scope the custom field to. Omit for global."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a toggle custom field definition in the specified setting if settingId is provided, or in the global scope otherwise."
