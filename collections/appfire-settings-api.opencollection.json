          "http": {
            "method": "DELETE",
            "url": "/api/v2/settings/customFields/:customFieldId",
            "params": [
              {
                "name": "customFieldId",
                "value": "",
                "type": "path"
              },
              {
                "name": "settingId",
                "value": "",
                "type": "query",
                "description": "Setting id the custom field belongs to. Omit for global."
              }
            ]
