        {
          "info": {
            "name": "Delete a custom field",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/v1/settings/customFields/:customFieldId",
            "params": [
              {
                "name": "customFieldId",
                "value": "",
                "type": "path"
              }
            ]
          },
