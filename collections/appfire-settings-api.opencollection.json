        {
          "info": {
            "name": "Update a toggle custom field",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/api/v2/settings/customFields/toggle/:customFieldId",
            "params": [
              {
                "name": "customFieldId",
                "value": "",
                "type": "path"
              },
              {
                "name": "settingId",
                "value": "",
                "type": "query",
                "description": "Setting id the custom field belongs to. Omit for global."
